{
  "name": "@ridewolf/city-flythrough",
  "version": "0.1.0",
  "description": "A procedural city with living traffic on a 2D canvas: deterministic world generation, traffic lights, roundabouts, lane changes, and adaptive performance. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ridewolf/city-flythrough.git"
  },
  "homepage": "https://github.com/Ridewolf/city-flythrough#readme",
  "bugs": "https://github.com/Ridewolf/city-flythrough/issues",
  "author": "Ridewolf (https://ridewolf.com)",
  "keywords": [
    "canvas",
    "procedural",
    "generative",
    "traffic",
    "simulation",
    "city",
    "background",
    "creative-coding"
  ],
  "scripts": {
    "prepare": "bun run scripts/install-hooks.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:switcher": "bun run scripts/docs-switcher.ts",
    "docs:switcher:check": "bun run scripts/docs-switcher.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "bench": "bun run benchmarks/frame.bench.ts",
    "changeset": "changeset",
    "build": "bun build ./src/index.ts --outdir dist --format esm --target browser && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.0",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.0",
    "@types/bun": "^1.3.14",
    "mitata": "^1.0.34",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
